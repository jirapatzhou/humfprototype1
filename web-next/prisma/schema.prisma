generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js (NextAuth) standard models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  memberships Membership[]
  coupons   Coupon[]
  visits    Visit[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- HUMF domain models ---

model Branch {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  lat         Float
  lng         Float
  capacityPct Int     @default(0)
  openUntil   String  @default("22:00")

  visits Visit[]
}

model Plan {
  id       String @id @default(cuid())
  key      String @unique // "starter" | "elite"
  name     String
  priceThb Int
  features Json

  memberships Membership[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  status    String   @default("active") // active | canceled
  startedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
}

model Coupon {
  id          String    @id @default(cuid())
  userId      String
  code        String
  title       String
  description String
  amountLabel String
  status      String    @default("active") // active | used | expired
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Visit {
  id          String    @id @default(cuid())
  userId      String
  branchId    String
  checkedInAt DateTime  @default(now())
  checkedOutAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([userId])
}
