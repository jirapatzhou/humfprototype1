# Copy this to .env.local for local development.
# In Vercel, set these under Project Settings -> Environment Variables instead
# of committing them — never put secrets in git.

# Vercel Postgres / Neon: Storage tab -> Create Database -> Postgres.
# Vercel auto-injects POSTGRES_URL and friends once connected to this project;
# Prisma wants a single DATABASE_URL, so either copy POSTGRES_PRISMA_URL's
# value here or add DATABASE_URL as an alias env var pointing at the same value.
DATABASE_URL=postgres://user:password@localhost:5432/humf

# Google Cloud Console -> APIs & Services -> Credentials -> your OAuth client
GOOGLE_CLIENT_ID=177078323646-72a4s4cc30gpgno10suhu47i52733f4f.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local dev: http://localhost:3000
# Production: your Vercel deployment URL, e.g. https://humf-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
