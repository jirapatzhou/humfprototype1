# Copy this to .env.local for local development.
# In Vercel, set these under Project Settings -> Environment Variables instead
# of committing them — never put the Client Secret or NEXTAUTH_SECRET in git.

# Google Cloud Console -> APIs & Services -> Credentials -> your OAuth client
GOOGLE_CLIENT_ID=177078323646-72a4s4cc30gpgno10suhu47i52733f4f.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Added once the Facebook Developer app exists
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local dev: http://localhost:3000
# Production: your Vercel deployment URL, e.g. https://humf-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
