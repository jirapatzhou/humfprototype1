# Copy this to .env.local for local development.
# In Vercel, set these under Project Settings -> Environment Variables instead
# of committing them — never put secrets in git, and never paste them in chat.

# Neon (or Vercel Postgres, which is Neon-backed): your Neon project gives you
# TWO connection strings — a pooled one (host has "-pooler" in it) and a
# direct/unpooled one (same host, no "-pooler"). Prisma needs both:
# DATABASE_URL for normal queries (pooled, add &pgbouncer=true) and DIRECT_URL
# for migrations (unpooled — PgBouncer's transaction pooling breaks the
# prepared statements/advisory locks `prisma migrate` needs).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Google Cloud Console -> APIs & Services -> Credentials -> your OAuth client
GOOGLE_CLIENT_ID=258068598214-itlhe59t7rrjdqe78si8agvp953750i8.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local dev: http://localhost:3000
# Production: your Vercel deployment URL (the default *.vercel.app one is
# fine — no custom domain needed), e.g. https://humf-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
